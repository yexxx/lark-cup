{
  "name": "lark-cup",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "migrate": "tsx server/migrate.ts",
    "seed": "tsx server/seed.ts",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:load": "tsx scripts/load.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "lucide-react": "^0.468.0",
    "parse5": "^8.0.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "prettier": "^3.9.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
