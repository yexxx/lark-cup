NODE_ENV=production
PORT=3001
PREVIEW_PORT=3002
APP_ORIGIN=http://localhost
PREVIEW_ORIGIN=http://localhost:8081
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://lark:replace-with-a-long-random-password@db:5432/lark
REDIS_URL=redis://redis:6379
UPLOAD_DIR=/app/data/uploads
DB_POOL_MAX=10
MAX_INFLIGHT=32
MAX_UPLOADS=2
REQUEST_TIMEOUT_MS=15000
LIST_CACHE_SECONDS=10
RANK_CACHE_SECONDS=15
IP_RATE_PER_MINUTE=240
VOTE_RATE_PER_MINUTE=20
UPLOAD_RATE_PER_MINUTE=10
TRUST_PROXY=true
